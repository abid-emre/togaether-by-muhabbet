  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Headings use Visore, sub-headers Caveat, body text DM Sans and italic accents Fraunces. Caveat, DM Sans and Fraunces are included. Visore is a licensed font: upload its .woff2 file in Content › Files and paste the file's link below. Until then headings use Outfit, a close free stand-in."
      },
      {
        "type": "text",
        "id": "visore_font_url",
        "label": "Visore font file link (.woff2)",
        "info": "e.g. https://cdn.shopify.com/s/files/…/Visore-Regular.woff2"
      },
      {
        "type": "range",
        "id": "heading_scale",
