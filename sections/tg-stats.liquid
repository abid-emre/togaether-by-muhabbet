{%- comment -%}
  Until today: a row of numbers that can count up when scrolled into view.
  A stat can count the city entries instead of a typed number, so it never
  disagrees with the calendar.
{%- endcomment -%}
<section
  id="{{ section.settings.anchor | default: 'stats' | handle }}"
  class="section stats{% if section.settings.surface %} section--surface{% endif %}"
>
  <div class="page-width">
    <div class="section-heading">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <ul class="stats__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign number = block.settings.number
          if block.settings.count_cities
            assign number = shop.metaobjects.city.values.size
          endif
        -%}
        <li class="stats__item" {{ block.shopify_attributes }}>
          <span class="stats__prefix">
            {%- if block.settings.prefix != blank -%}
              {{- block.settings.prefix | escape -}}
            {%- else -%}
              &nbsp;
            {%- endif -%}
          </span>
          <span class="stats__number">
            <span
              {% if section.settings.count_up %}
                data-count-to="{{ number | escape }}"
              {% endif %}
            >
              {{- number | escape -}}
            </span>
            {{- block.settings.suffix | escape -}}
          </span>
          <span class="stats__label">{{ block.settings.label | escape }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{%- if section.settings.count_up -%}
  <script src="{{ 'tg-count.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Stats",
  "tag": "div",
  "class": "section-stats",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "stats" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "until today" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "what we have gathered so far." },
    { "type": "checkbox", "id": "count_up", "label": "Count up on scroll", "default": true },
    { "type": "checkbox", "id": "surface", "label": "Use surface background", "default": false }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "prefix", "label": "Small word above", "default": "approx.", "info": "e.g. approx., over, about" },
        { "type": "text", "id": "number", "label": "Number", "default": "5700" },
        { "type": "text", "id": "suffix", "label": "After the number", "info": "e.g. +" },
        { "type": "text", "id": "label", "label": "Label", "default": "participants" },
        {
          "type": "checkbox",
          "id": "count_cities",
          "label": "Count city entries instead",
          "default": false,
          "info": "Uses the number of entries in Content › Metaobjects › City."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats",
      "blocks": [
        { "type": "stat", "settings": { "prefix": "approx.", "number": "5700", "label": "participants" } },
        { "type": "stat", "settings": { "prefix": "over", "number": "1900", "label": "hours of conversation" } },
        { "type": "stat", "settings": { "prefix": "over", "number": "450", "label": "events" } },
        { "type": "stat", "settings": { "prefix": "about", "number": "150", "label": "venues" } },
        { "type": "stat", "settings": { "prefix": "", "number": "16", "suffix": "+", "label": "countries & cities" } }
      ]
    }
  ]
}
{% endschema %}
