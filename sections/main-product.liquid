{%- comment -%}
  Board game product page (wireframe 1d): photo gallery on the left; kicker,
  title, price, short text, players / play time / age, edition chips, quantity,
  add to cart and buy it now on the right, then collapsible tabs.

  Editions are product variants. Players, play time and age come from the
  product metafields custom.players, custom.play_time and custom.age.

  One template serves every product (card games, journals, gift sets), so the
  per-product text comes from the product itself: the short text under the
  price reads custom.summary first, and a collapsible tab can read any product
  metafield (for example custom.how_to_play). A tab with nothing to show is
  hidden.

  "Where to buy" decides the buy area. "On another store" swaps quantity, add
  to cart and buy it now for one link button that opens the product on the
  sister store (Youwa). The link is the product's custom.youwa_url metafield,
  or the fallback link in the section settings.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign kicker = section.settings.kicker | default: product.type
  assign players = product.metafields.custom.players.value
  assign play_time = product.metafields.custom.play_time.value
  assign age = product.metafields.custom.age.value
  assign summary = product.metafields.custom.summary | metafield_tag
  if product.metafields.custom.summary == blank
    assign summary = section.settings.summary
  endif
  assign form_id = 'ProductForm-' | append: section.id
  assign sell_external = false
  if section.settings.buy_mode == 'external'
    assign sell_external = true
    assign link_key = section.settings.external_metafield | default: 'custom.youwa_url' | strip | split: '.'
    assign external_url = ''
    if link_key.size == 2
      assign external_url = product.metafields[link_key[0]][link_key[1]].value | default: product.metafields[link_key[0]][link_key[1]]
    endif
    comment
      Common names for the same field, in case it was created under another key.
    endcomment
    if external_url == blank
      assign external_url = product.metafields.custom.youwa_url.value | default: product.metafields.custom.youwa_link.value | default: product.metafields.custom.youwa.value
    endif
    if external_url == blank
      assign external_url = section.settings.external_fallback_url
    endif
  endif
-%}

<section class="section product-page">
  <tg-product
    class="page-width product"
    data-section="{{ section.id }}"
    data-url="{{ product.url }}"
  >
    <div class="product__gallery">
      {%- if featured -%}
        <div class="product__main-media">
          {{
            featured
            | image_url: width: 1400
            | image_tag:
              class: 'product__main-image plate',
              loading: 'eager',
              widths: '600, 900, 1200, 1400',
              sizes: '(min-width: 990px) 55vw, 100vw'
          }}
        </div>
      {%- else -%}
        <div class="product__main-media product__main-media--empty plate" aria-hidden="true"></div>
      {%- endif -%}

      {%- if product.media.size > 1 -%}
        <ul class="product__thumbs" role="list">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <li>
                <button
                  type="button"
                  class="product__thumb"
                  data-media-id="{{ media.id }}"
                  data-src="{{ media | image_url: width: 1400 }}"
                  data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1400 }} 1400w"
                  data-alt="{{ media.alt | escape }}"
                  aria-label="{{ 'products.product.show_image' | t: number: forloop.index }}"
                  {% if media.id == featured.id %}aria-current="true"{% endif %}
                >
                  {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if kicker != blank -%}
        <span class="kicker">{{ kicker | escape }}</span>
      {%- endif -%}
      <h1 class="product__title">{{ product.title | escape }}</h1>

      <p class="product__price" data-price>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
          {{ current_variant.price | money }}
          <s class="text-muted">{{ current_variant.compare_at_price | money }}</s>
        {%- else -%}
          {{ current_variant.price | money }}
        {%- endif -%}
      </p>

      {%- if summary != blank -%}
        <div class="product__summary rte">{{ summary }}</div>
      {%- endif -%}

      {%- if players != blank or play_time != blank or age != blank -%}
        <ul class="product__facts" role="list">
          {%- if players != blank -%}
            <li>{% render 'tg-icon', icon: 'users' %}{{ 'products.product.players' | t: players: players }}</li>
          {%- endif -%}
          {%- if play_time != blank -%}
            <li>{% render 'tg-icon', icon: 'clock' %}{{ play_time | escape }}</li>
          {%- endif -%}
          {%- if age != blank -%}
            <li>{% render 'tg-icon', icon: 'people' %}{{ age | escape }}</li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      {%- capture option_picker -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="product__option">
              <legend class="product__option-label">{{ option.name | escape }}</legend>
              <div class="product__option-values">
                {%- for value in option.values -%}
                  {%- assign input_id = form_id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                  <input
                    class="product__option-input visually-hidden"
                    type="radio"
                    id="{{ input_id }}"
                    name="option-{{ option.position }}"
                    value="{{ value | escape }}"
                    data-option-position="{{ option.position }}"
                    {% if option.selected_value == value %}checked{% endif %}
                  >
                  <label class="chip" for="{{ input_id }}">{{ value | escape }}</label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}
      {%- endcapture -%}

      {%- if sell_external -%}
        <div class="product__form">
          {{ option_picker }}
          {%- if external_url != blank -%}
            <div class="product__buy">
              <a
                class="btn btn-solid product__add product__external"
                href="{{ external_url }}"
                target="_blank"
                rel="noopener"
              >
                {{- section.settings.external_label | default: 'shop on Youwa' | escape -}}
                {%- render 'tg-icon', icon: 'arrow-up-right' -%}
                <span class="visually-hidden">{{ 'products.product.opens_new_window' | t }}</span>
              </a>
            </div>
          {%- endif -%}
          {%- if section.settings.external_note != blank -%}
            <div class="product__external-note rte text-muted">{{ section.settings.external_note }}</div>
          {%- endif -%}
        </div>
      {%- else -%}
      {%- form 'product', product, id: form_id, class: 'product__form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {{ option_picker }}

        <div class="product__buy">
          {%- if section.settings.show_quantity -%}
            <div class="quantity">
              <button type="button" class="quantity__button" data-quantity="-1">
                {% render 'tg-icon', icon: 'minus' %}
                <span class="visually-hidden">{{ 'products.product.decrease' | t }}</span>
              </button>
              <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
              <input class="quantity__input" type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric">
              <button type="button" class="quantity__button" data-quantity="1">
                {% render 'tg-icon', icon: 'plus' %}
                <span class="visually-hidden">{{ 'products.product.increase' | t }}</span>
              </button>
            </div>
          {%- endif -%}
          <button
            type="submit"
            name="add"
            class="btn btn-solid product__add"
            data-add-button
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        </div>

        {%- if section.settings.show_dynamic_checkout -%}
          <div class="product__checkout">{{ form | payment_button }}</div>
        {%- endif -%}
      {%- endform -%}
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="product__tabs">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'collapsible_tab' -%}
                {%- liquid
                  assign tab_content = block.settings.content
                  if block.settings.use_description
                    assign tab_content = product.description
                  endif
                  if block.settings.page != blank
                    assign tab_content = block.settings.page.content
                  endif
                  if block.settings.metafield != blank
                    assign mf_parts = block.settings.metafield | strip | split: '.'
                    if mf_parts.size == 2
                      assign mf = product.metafields[mf_parts[0]][mf_parts[1]]
                      if mf != blank
                        assign tab_content = mf | metafield_tag
                      elsif block.settings.metafield_only
                        assign tab_content = ''
                      endif
                    endif
                  endif
                -%}
                {%- if block.settings.heading != blank and tab_content != blank -%}
                  <details class="accordion" {{ block.shopify_attributes }}>
                    <summary class="accordion__summary">
                      <span>{{ block.settings.heading | escape }}</span>
                      {% render 'tg-icon', icon: 'plus', class: 'accordion__icon' %}
                    </summary>
                    <div class="accordion__content rte">{{ tab_content }}</div>
                  </details>
                {%- endif -%}
              {%- when 'text' -%}
                <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <script type="application/json" data-variants>
      {%- capture labels -%}
        {"add": {{ 'products.product.add_to_cart' | t | json }}, "soldOut": {{ 'products.product.sold_out' | t | json }}, "unavailable": {{ 'products.product.unavailable' | t | json }}}
      {%- endcapture -%}
      {%- capture prices -%}
        {%- for variant in product.variants -%}
          "{{ variant.id }}": {"price": {{ variant.price | money | json }}, "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {%- endcapture -%}
      {"variants": {{ product.variants | json }}, "prices": { {{ prices }} }, "labels": {{ labels }}}
    </script>
  </tg-product>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
      "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "brand": {"@type": "Brand", "name": {{ shop.name | json }}},
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "name": {{ variant.title | json }},
          {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
          "availability": "https://schema.org/{% if variant.available or sell_external %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {% if sell_external and external_url != blank %}{{ external_url | json }}{% else %}{{ request.origin | append: variant.url | json }}{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

<script src="{{ 'tg-product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "info": "Small line above the title, the same on every product. Leave empty to use each product's type."
    },
    {
      "type": "richtext",
      "id": "summary",
      "label": "Short text under the price",
      "info": "Fallback for products without a custom.summary metafield. One or two lines; the full description goes in a tab below."
    },
    {
      "type": "header",
      "content": "Where to buy"
    },
    {
      "type": "select",
      "id": "buy_mode",
      "label": "Where to buy",
      "options": [
        { "value": "store", "label": "In this store (add to cart)" },
        { "value": "external", "label": "On another store (link button)" }
      ],
      "default": "external"
    },
    {
      "type": "text",
      "id": "external_label",
      "label": "Link button text",
      "default": "shop on Youwa"
    },
    {
      "type": "text",
      "id": "external_metafield",
      "label": "Product metafield with the Youwa link",
      "default": "custom.youwa_url",
      "info": "namespace.key, as shown in Settings › Custom data › Products."
    },
    {
      "type": "url",
      "id": "external_fallback_url",
      "label": "Fallback link",
      "info": "Used when a product has no custom.youwa_url metafield, for example the Youwa shop page."
    },
    {
      "type": "richtext",
      "id": "external_note",
      "label": "Note under the button",
      "default": "<p>Our products are sold and shipped by our sister brand Youwa.</p>"
    },
    {
      "type": "header",
      "content": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show \"buy it now\" button",
      "default": true,
      "info": "Shows the fastest checkout option the customer has set up, such as Shop Pay."
    },
    {
      "type": "paragraph",
      "content": "Editions are product variants (for example English, Türkçe, Español). Players, play time and age come from the product metafields custom.players, custom.play_time and custom.age. The short text reads custom.summary first."
    }
  ],
  "blocks": [
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "how to play"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "checkbox",
          "id": "use_description",
          "label": "Use the product description",
          "default": false
        },
        {
          "type": "page",
          "id": "page",
          "label": "Or show a page",
          "info": "Useful for shipping or returns text shared by every product."
        },
        {
          "type": "text",
          "id": "metafield",
          "label": "Or read a product metafield",
          "placeholder": "custom.how_to_play",
          "info": "namespace.key of a product metafield. When the product has it, it wins over the text above."
        },
        {
          "type": "checkbox",
          "id": "metafield_only",
          "label": "Hide the tab when the product has no value",
          "default": true,
          "info": "Turn off to fall back to the content above."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
