<section class="section">
  <div class="page-width">
    <h1 class="main-page__title">{{ blog.title | escape }}</h1>
    {%- paginate blog.articles by 12 -%}
      <ul class="product-grid" role="list">
        {%- for article in blog.articles -%}
          <li>
            <a class="card" href="{{ article.url }}">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: class: 'plate', loading: 'lazy' }}
              {%- endif -%}
              <span class="card-meta">{{ article.published_at | time_tag: format: 'date' }}</span>
              <span class="card-title">{{ article.title | escape }}</span>
              <span class="card-body">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "div",
  "settings": []
}
{% endschema %}
