{%- comment -%}
  Memory room: an edge-to-edge photo carousel that slides by itself, with
  captions on hover, followed by a row of Instagram tiles (no live feed).
{%- endcomment -%}
{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign tiles = section.blocks | where: 'type', 'ig_tile'
-%}

<section
  id="{{ section.settings.anchor | default: 'memory-room' | handle }}"
  class="section memory-room"
>
  <div class="page-width">
    <div class="section-heading">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="section-heading__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- if slides.size > 0 -%}
    <tg-carousel
      class="carousel"
      data-autoplay="{{ section.settings.autoplay_seconds | times: 1000 }}"
      style="--per-view: {{ section.settings.per_view }};"
    >
      <ul class="carousel__track" role="list" aria-label="{{ section.settings.heading | escape }}" data-track>
        {%- for block in slides -%}
          {%- liquid
            assign place = block.settings.city
            if block.settings.year != blank
              if place != blank
                assign place = place | append: ', ' | append: block.settings.year
              else
                assign place = block.settings.year
              endif
            endif
            assign caption = block.settings.event
            if place != blank
              if caption != blank
                assign caption = caption | append: ' — ' | append: place
              else
                assign caption = place
              endif
            endif
          -%}
          <li class="carousel__slide" data-slide {{ block.shopify_attributes }}>
            <figure class="memory-room__figure">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'memory-room__image',
                    alt: caption,
                    loading: 'lazy',
                    widths: '500, 800, 1100, 1400',
                    sizes: '(min-width: 750px) calc(100vw / 3), 100vw'
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'memory-room__image memory-room__placeholder' }}
              {%- endif -%}
              {%- if caption != blank -%}
                <figcaption class="memory-room__caption">{{ caption | escape }}</figcaption>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>

      <div class="page-width carousel__controls">
        <span class="carousel__hint text-muted">{{ 'sections.memory_room.hint' | t }}</span>
        <div class="carousel__nav">
          <div class="carousel__dots" data-dots></div>
          <button type="button" class="btn btn-icon" data-prev>
            {% render 'tg-icon', icon: 'chevron-left' %}
            <span class="visually-hidden">{{ 'sections.memory_room.previous' | t }}</span>
          </button>
          <button type="button" class="btn btn-icon" data-next>
            {% render 'tg-icon', icon: 'chevron-right' %}
            <span class="visually-hidden">{{ 'sections.memory_room.next' | t }}</span>
          </button>
        </div>
      </div>
    </tg-carousel>
  {%- endif -%}

  {%- if tiles.size > 0 -%}
    <div class="page-width memory-room__instagram">
      <div class="memory-room__instagram-header">
        <span class="memory-room__instagram-title">
          {% render 'tg-icon', icon: 'instagram' %}
          {{ section.settings.instagram_heading | escape }}
        </span>
        {%- if settings.social_instagram_link != blank and section.settings.instagram_label != blank -%}
          <a class="btn btn-ghost" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">
            {{- section.settings.instagram_label | escape -}}
            {% render 'tg-icon', icon: 'arrow-up-right' %}
          </a>
        {%- endif -%}
      </div>
      <ul class="memory-room__tiles" role="list">
        {%- for block in tiles -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="memory-room__tile" href="{{ block.settings.link }}" target="_blank" rel="noopener">
            {%- else -%}
              <div class="memory-room__tile">
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  alt: block.settings.image.alt,
                  loading: 'lazy',
                  widths: '300, 450, 600',
                  sizes: '(min-width: 750px) 25vw, 50vw'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'memory-room__placeholder' }}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <span class="visually-hidden">{{ 'sections.memory_room.view_post' | t }}</span>
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

<script src="{{ 'tg-carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Memory room",
  "tag": "div",
  "class": "section-memory-room",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "memory-room"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "our memory room"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "memories that still breathe."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Slide every",
      "min": 3,
      "max": 8,
      "step": 0.5,
      "unit": "s",
      "default": 4.5,
      "info": "Autoplay pauses on hover and stays off for visitors who prefer reduced motion."
    },
    {
      "type": "range",
      "id": "per_view",
      "label": "Photos per view on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "Phones always show one photo at a time."
    },
    {
      "type": "header",
      "content": "Instagram row"
    },
    {
      "type": "text",
      "id": "instagram_heading",
      "label": "Heading",
      "default": "lately on instagram"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Follow link label",
      "default": "follow @togaether_by_muhabbet",
      "info": "Links to the Instagram account in Theme settings › Social media."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "event",
          "label": "Event",
          "default": "collective flow"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City",
          "default": "büyükada"
        },
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2026"
        },
        {
          "type": "paragraph",
          "content": "Event, city and year make the caption and the photo's alt text."
        }
      ]
    },
    {
      "type": "ig_tile",
      "name": "Instagram tile",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Instagram post link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Memory room",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "ig_tile" },
        { "type": "ig_tile" },
        { "type": "ig_tile" },
        { "type": "ig_tile" }
      ]
    }
  ]
}
{% endschema %}
