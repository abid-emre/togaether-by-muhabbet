{%- comment -%}
  "Opening soon" page shown while the store is password protected.
{%- endcomment -%}
<div class="password-page">
  <div class="password-page__inner">
    <span class="kicker">{{ shop.name }}</span>
    <h1 class="display">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="text-muted">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'password-page__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'templates.password.subscribed' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="PasswordNewsletter">{{ 'templates.password.email' | t }}</label>
        <input class="input" id="PasswordNewsletter" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'templates.password.email' | t }}" required>
        <button type="submit" class="btn btn-primary">{{ 'templates.password.notify' | t }}</button>
      {%- endif -%}
    {%- endform -%}

    <details>
      <summary>{{ 'templates.password.enter_with_password' | t }}</summary>
      {%- form 'storefront_password', class: 'password-page__form' -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error">{{ 'templates.password.wrong_password' | t }}</p>
        {%- endif -%}
        <label class="visually-hidden" for="StorefrontPassword">{{ 'templates.password.password' | t }}</label>
        <input class="input" id="StorefrontPassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'templates.password.password' | t }}">
        <button type="submit" class="btn btn-secondary">{{ 'templates.password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "something gentle is on its way."
    }
  ]
}
{% endschema %}
