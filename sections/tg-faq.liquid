{%- comment -%}
  First time here? A heading and a "why we ask you to apply" box on the left,
  questions as accordions on the right. Outputs FAQ structured data for search.
{%- endcomment -%}
<section
  id="{{ section.settings.anchor | default: 'first-time' | handle }}"
  class="section faq{% if section.settings.surface %} section--surface{% endif %}"
>
  <div class="page-width faq__grid">
    <div class="faq__intro">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.box_title != blank or section.settings.box_text != blank -%}
        <div class="faq__box">
          <p class="faq__box-title">
            {% render 'tg-icon', icon: 'info' %}
            {{ section.settings.box_title | escape }}
          </p>
          <div class="rte">{{ section.settings.box_text }}</div>
        </div>
      {%- endif -%}
    </div>

    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span>{{ block.settings.question | escape }}</span>
            {% render 'tg-icon', icon: 'plus', class: 'accordion__icon' %}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "First time FAQ",
  "tag": "div",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "first-time" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "first time here?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "what to expect at your first circle." },
    { "type": "header", "content": "Highlight box" },
    { "type": "text", "id": "box_title", "label": "Title", "default": "why we ask you to apply" },
    { "type": "richtext", "id": "box_text", "label": "Text", "default": "<p>Each circle is small and carefully balanced. A short application helps us bring together people who will feel at home with each other.</p>" },
    { "type": "checkbox", "id": "surface", "label": "Use surface background", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "will i be seated with strangers?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes, and that's the point. Your host guides the first moments so nobody is left on their own.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "First time FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "will i be seated with strangers?" } },
        { "type": "question", "settings": { "question": "do i have to speak?" } },
        { "type": "question", "settings": { "question": "what language is the event in?" } },
        { "type": "question", "settings": { "question": "how long does it last?" } },
        { "type": "question", "settings": { "question": "what does it cost?" } },
        { "type": "question", "settings": { "question": "why do i need to apply?" } }
      ]
    }
  ]
}
{% endschema %}
