<section class="section">
  <div class="page-width">
    <h1 class="main-page__title">{{ 'templates.list_collections.title' | t }}</h1>
    <ul class="product-grid" role="list">
      {%- for collection in collections -%}
        <li>
          <a class="card" href="{{ collection.url }}">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 600 | image_tag: class: 'plate', loading: 'lazy' }}
            {%- endif -%}
            <span class="card-title">{{ collection.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "tag": "div",
  "settings": []
}
{% endschema %}
