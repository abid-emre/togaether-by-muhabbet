{%- comment -%}
  Header: logo, main menu, language switcher, Instagram and an "apply" button.
  Below 990px the menu, languages and Instagram move into the ☰ drawer.
{%- endcomment -%}
{%- liquid
  assign apply_block = section.blocks | where: 'type', 'apply_button' | first
  assign instagram = settings.social_instagram_link
-%}

<header
  class="header-wrapper{% if section.settings.sticky %} header-wrapper--sticky{% endif %}"
  data-header
>
  <div class="header page-width">
    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo">
    {%- else -%}
      <div class="header__logo">
    {%- endif -%}
    <a href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_height = section.settings.logo_height -%}
        {%- assign logo_width = logo_height | times: section.settings.logo.aspect_ratio | round -%}
        {%- assign logo_height_2x = logo_height | times: 2 -%}
        {{
          section.settings.logo
          | image_url: height: logo_height_2x
          | image_tag:
            alt: shop.name,
            width: logo_width,
            height: logo_height,
            style: 'max-height: none;',
            preload: true
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- else -%}
      </div>
    {%- endif -%}

    {%- if section.settings.menu != blank -%}
      <nav class="header__nav" aria-label="{{ 'sections.header.menu' | t }}">
        <ul class="header__menu" role="list">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="header__tools">
      {%- if section.settings.show_languages -%}
        {% render 'tg-localization', form_id: 'HeaderLanguageForm' %}
      {%- endif -%}

      {%- if section.settings.show_instagram and instagram != blank -%}
        <a class="btn btn-icon header__social" href="{{ instagram }}" target="_blank" rel="noopener">
          {% render 'tg-icon', icon: 'instagram' %}
          <span class="visually-hidden">{{ 'general.social.instagram' | t }}</span>
        </a>
      {%- endif -%}

      {%- if apply_block and apply_block.settings.label != blank -%}
        <a
          class="btn btn-primary"
          href="{{ apply_block.settings.link | default: '#' }}"
          {{ apply_block.shopify_attributes }}
        >
          {{- apply_block.settings.label | escape -}}
        </a>
      {%- endif -%}

      <button
        type="button"
        class="btn btn-icon header__menu-toggle"
        aria-controls="MenuDrawer"
        aria-expanded="false"
        data-drawer-open
      >
        {% render 'tg-icon', icon: 'menu' %}
        <span class="visually-hidden">{{ 'sections.header.open_menu' | t }}</span>
      </button>
    </div>
  </div>
</header>

<div class="menu-drawer" id="MenuDrawer" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}" data-drawer hidden>
  <div class="menu-drawer__backdrop" data-drawer-close></div>
  <div class="menu-drawer__panel">
    <button type="button" class="btn btn-icon menu-drawer__close" data-drawer-close>
      {% render 'tg-icon', icon: 'close' %}
      <span class="visually-hidden">{{ 'sections.header.close_menu' | t }}</span>
    </button>

    {%- if section.settings.menu != blank -%}
      <nav aria-label="{{ 'sections.header.menu' | t }}">
        <ul class="menu-drawer__menu" role="list">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}" data-drawer-link {% if link.current %}aria-current="page"{% endif %}>
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="menu-drawer__footer">
      {%- if apply_block and apply_block.settings.label != blank -%}
        <a class="btn btn-solid btn-block" href="{{ apply_block.settings.link | default: '#' }}" data-drawer-link>
          {{- apply_block.settings.label | escape -}}
        </a>
      {%- endif -%}

      {%- if section.settings.show_languages -%}
        {% render 'tg-localization', form_id: 'DrawerLanguageForm' %}
      {%- endif -%}

      {%- if section.settings.show_instagram and instagram != blank -%}
        <a class="btn btn-ghost menu-drawer__social" href="{{ instagram }}" target="_blank" rel="noopener">
          {% render 'tg-icon', icon: 'instagram' %}
          {{ 'general.social.instagram' | t }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "max_blocks": 1,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to show the store name in the heading font."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Use anchor links such as /#approach or /#calendar to jump to homepage sections."
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to the top on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_languages",
      "label": "Show language selector",
      "default": true,
      "info": "Appears once more than one language is published in Settings › Languages."
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram icon",
      "default": true,
      "info": "Link comes from Theme settings › Social media."
    }
  ],
  "blocks": [
    {
      "type": "apply_button",
      "name": "Apply button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "apply to join"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
