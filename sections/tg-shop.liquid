{%- comment -%}
  Homepage "shop" row: products from one collection as cards.
  Ships hidden on the homepage. Show it in the theme editor at launch.
{%- endcomment -%}
{%- assign collection = section.settings.collection -%}
<section
  id="{{ section.settings.anchor | default: 'shop' | handle }}"
  class="section shop{% if section.settings.surface %} section--surface{% endif %}"
>
  <div class="page-width">
    <div class="section-heading section-heading--split">
      <div>
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="section-heading__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        {%- assign link = section.settings.link | default: collection.url | default: routes.all_products_collection_url -%}
        <a class="btn btn-ghost" href="{{ link | escape }}">
          {{- section.settings.link_label | escape }}
          {% render 'tg-icon', icon: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <ul class="product-grid" role="list">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          <li>{% render 'tg-product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li>
            <div class="card product-card">
              <span class="product-card__placeholder plate" aria-hidden="true"></span>
              <span class="card-title">{{ 'sections.shop.placeholder_title' | t }}</span>
              <span class="card-meta">{{ 'sections.shop.placeholder_text' | t }}</span>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Shop row",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Hidden until launch: click the eye icon next to this section to show it."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "the shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "take the circle home"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>The card games we play at our gatherings, in English, Türkçe and Español.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "see all"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Link",
      "info": "Leave empty to link to the collection."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "shop",
      "info": "Lets menus link here with /#shop."
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Use the surface background",
      "default": false
    }
  ],
  "presets": [{ "name": "Shop row" }]
}
{% endschema %}
