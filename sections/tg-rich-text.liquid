{%- comment -%}
  Simple text band: kicker, heading, text and a button. Used as the homepage
  placeholder until the designed sections arrive, and handy on any page.
{%- endcomment -%}
<section
  id="{{ section.settings.anchor | default: section.id | handle }}"
  class="section{% if section.settings.surface %} section--surface{% endif %}"
>
  <div class="page-width page-width--narrow text-{{ section.settings.alignment }}">
    {%- if section.settings.kicker != blank -%}
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="{% if section.settings.display_heading %}display{% else %}h1{% endif %}">
        {{- section.settings.heading | escape -}}
      </h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <p class="section__actions">
        <a class="btn btn-primary" href="{{ section.settings.button_link | default: '#' | escape }}">
          {{- section.settings.button_label | escape -}}
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets menu links jump here, e.g. \"approach\" for /#approach."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "come as you are. leave connected."
    },
    {
      "type": "checkbox",
      "id": "display_heading",
      "label": "Large display heading",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "info": "A page link like /pages/about, a homepage anchor like /#calendar, or a full URL."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Use surface background",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
