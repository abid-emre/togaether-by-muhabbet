{%- comment -%}
  Renders an inline SVG icon.

  Accepts:
  - icon {String}: menu, close, instagram, whatsapp, linkedin, email, arrow-right,
    arrow-up-right, chevron-left, chevron-right, plus, info, clock, sparkle, quote,
    heart, grid, lines, flower, waves, pin, calendar, home, language, tag, users,
    building, link, people
  - class {String}: optional extra classes

  Usage:
  {% render 'tg-icon', icon: 'instagram' %}
{%- endcomment -%}
{%- liquid
  assign classes = 'icon icon-' | append: icon
  if class != blank
    assign classes = classes | append: ' ' | append: class
  endif
-%}
<svg class="{{ classes }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {%- case icon -%}
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none"/>
    {%- when 'whatsapp' -%}
      <path d="M4 20l1.2-3.9A8 8 0 1 1 8 18.9L4 20z"/>
      <path d="M9.2 8.6c.2-.4.5-.5.8-.5h.4c.2 0 .3.1.4.3l.6 1.4c.1.2 0 .4-.1.5l-.4.5c-.1.1-.1.3 0 .4.6 1 1.4 1.8 2.4 2.3.2.1.3.1.4 0l.5-.5c.1-.1.3-.2.5-.1l1.4.6c.2.1.3.2.3.4v.4c0 .3-.2.6-.5.8-.5.3-1.2.4-1.9.2-2.3-.7-4.1-2.5-4.8-4.8-.2-.7-.1-1.4.2-1.9z" fill="currentColor" stroke="none"/>
    {%- when 'linkedin' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="2.5"/>
      <path d="M8 10.5V16M8 7.8v.1M11.5 16v-5.5M11.5 13c0-1.5 1-2.6 2.4-2.6s2.1 1 2.1 2.6V16"/>
    {%- when 'email' -%}
      <rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/>
      <path d="M4 7l8 6 8-6"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-up-right' -%}
      <path d="M7 17L17 7M8 7h9v9"/>
    {%- when 'chevron-left' -%}
      <path d="M15 5l-7 7 7 7"/>
    {%- when 'chevron-right' -%}
      <path d="M9 5l7 7-7 7"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'info' -%}
      <circle cx="12" cy="12" r="8.5"/>
      <path d="M12 11v5.5M12 7.8v.1"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/>
      <path d="M12 7.5V12l3 2"/>
    {%- when 'sparkle' -%}
      <path d="M12 3.5c.6 4.4 2.6 7.4 8.5 8.5-5.9 1.1-7.9 4.1-8.5 8.5-.6-4.4-2.6-7.4-8.5-8.5 5.9-1.1 7.9-4.1 8.5-8.5z"/>
    {%- when 'quote' -%}
      <path d="M10 7c-3 1-4.5 3.5-4.5 6.5V17H10v-4H7.6M18.5 7c-3 1-4.5 3.5-4.5 6.5V17h4.5v-4h-2.4"/>
    {%- when 'heart' -%}
      <path d="M12 19.5s-7.5-4.4-7.5-9.8A4.2 4.2 0 0 1 12 7.3a4.2 4.2 0 0 1 7.5 2.4c0 5.4-7.5 9.8-7.5 9.8z"/>
    {%- when 'grid' -%}
      <rect x="4" y="4" width="6.5" height="6.5" rx="1"/>
      <rect x="13.5" y="4" width="6.5" height="6.5" rx="1"/>
      <rect x="4" y="13.5" width="6.5" height="6.5" rx="1"/>
      <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1"/>
    {%- when 'lines' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
      <circle cx="8" cy="7" r="1.2" fill="currentColor"/>
      <circle cx="14" cy="12" r="1.2" fill="currentColor"/>
      <circle cx="10" cy="17" r="1.2" fill="currentColor"/>
    {%- when 'flower' -%}
      <circle cx="12" cy="12" r="2.2"/>
      <path d="M12 9.8c-1.6-2.4-1.6-4.6 0-6.3 1.6 1.7 1.6 3.9 0 6.3zM12 14.2c1.6 2.4 1.6 4.6 0 6.3-1.6-1.7-1.6-3.9 0-6.3zM9.8 12c-2.4 1.6-4.6 1.6-6.3 0 1.7-1.6 3.9-1.6 6.3 0zM14.2 12c2.4-1.6 4.6-1.6 6.3 0-1.7 1.6-3.9 1.6-6.3 0z"/>
    {%- when 'waves' -%}
      <path d="M3.5 9c2.1-1.6 4.2-1.6 6.3 0s4.2 1.6 6.3 0 3.2-1.2 4.4-.6M3.5 15c2.1-1.6 4.2-1.6 6.3 0s4.2 1.6 6.3 0 3.2-1.2 4.4-.6"/>
    {%- when 'pin' -%}
      <path d="M12 20.5s6-5.3 6-10.5a6 6 0 1 0-12 0c0 5.2 6 10.5 6 10.5z"/>
      <circle cx="12" cy="10" r="2.2"/>
    {%- when 'calendar' -%}
      <rect x="4" y="5.5" width="16" height="14" rx="1.5"/>
      <path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/>
    {%- when 'home' -%}
      <path d="M4.5 11L12 4.5l7.5 6.5V19.5h-15z"/>
      <path d="M10 19.5v-5h4v5"/>
    {%- when 'language' -%}
      <circle cx="12" cy="12" r="8.5"/>
      <path d="M3.5 12h17M12 3.5c2.3 2.4 3.4 5.2 3.4 8.5s-1.1 6.1-3.4 8.5c-2.3-2.4-3.4-5.2-3.4-8.5s1.1-6.1 3.4-8.5z"/>
    {%- when 'tag' -%}
      <path d="M4 12.6V4.5h8.1l7.4 7.4-8.1 8.1z"/>
      <circle cx="8.3" cy="8.8" r="1.2"/>
    {%- when 'users' -%}
      <circle cx="9" cy="8.5" r="3"/>
      <path d="M3.5 19c.6-3.2 2.7-5 5.5-5s4.9 1.8 5.5 5M15.5 5.8a3 3 0 0 1 0 5.4M17 14.3c1.9.6 3.1 2.2 3.5 4.7"/>
    {%- when 'people' -%}
      <circle cx="7" cy="9" r="2.2"/>
      <circle cx="17" cy="9" r="2.2"/>
      <circle cx="12" cy="7" r="2.2"/>
      <path d="M3.5 18c.4-2.5 1.7-4 3.5-4M20.5 18c-.4-2.5-1.7-4-3.5-4M8 18.5c.5-3 1.9-4.6 4-4.6s3.5 1.6 4 4.6"/>
    {%- when 'building' -%}
      <rect x="5" y="3.5" width="14" height="17" rx="1"/>
      <path d="M9 7.5h1.5M13.5 7.5H15M9 11h1.5M13.5 11H15M9 14.5h1.5M13.5 14.5H15M10.5 20.5v-3h3v3"/>
    {%- when 'link' -%}
      <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>
  {%- endcase -%}
</svg>
